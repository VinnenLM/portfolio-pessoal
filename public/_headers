# APKs baixam como arquivo (e o celular reconhece como app Android)
/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment

# Deadfront muda a cada atualização: sempre buscar a versão mais nova
/deadfront/*
  Cache-Control: no-cache

# Popmancer também muda a cada atualização
/popmancer/*
  Cache-Control: no-cache

# Fortmancer também muda a cada atualização
/fortmancer/*
  Cache-Control: no-cache
